{
  "name": "echo-roulette",
  "version": "1.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:worker && npm run check:client && npm run check:markup && npm run check:project && npm run check:static && npm run check:runtime && npm run test:stress",
    "check:worker": "node --check src/index.js && node --check src/matching.js",
    "check:client": "node --check public/app.js",
    "check:markup": "node tests/check-markup.mjs",
    "test:stress": "node tests/stress-matchmaking.mjs",
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "check:project": "node tests/check-project.mjs",
    "check:static": "node tests/smoke-static.mjs",
    "check:runtime": "node tests/smoke-runtime.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.144.0"
  }
}
