{
  "name": "echo-roulette",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:worker && npm run check:client && npm run test:stress",
    "check:worker": "node --check src/index.js && node --check src/matching.js",
    "check:client": "node --check public/app.js",
    "test:stress": "node tests/stress-matchmaking.mjs",
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.143.0"
  }
}
