{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "echo-roulette",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "ptornsaso0@gmail.com"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBY",
        "class_name": "Lobby"
      }
    ]
  },
  "exports": {
    "Lobby": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
